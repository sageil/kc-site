PORT=3000
# NODE_ENV=production   # requires SMTP_HOST; without SMTP in dev, messages are logged to the console

# SMTP: Hostinger mail is smtp.hostinger.com, port 465, the mailbox address and its password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# MAIL_FROM must be an address your SMTP provider allows you to send from
MAIL_FROM="KodaCode Website <hello@kodacode.dev>"
MAIL_TO=hello@kodacode.dev

# Set to 1 when running behind one reverse proxy / load balancer so rate limiting sees real client IPs
# TRUST_PROXY=1

# Serve the website/ folder directly while developing; the published app serves ./public
# SITE_DIR=..
